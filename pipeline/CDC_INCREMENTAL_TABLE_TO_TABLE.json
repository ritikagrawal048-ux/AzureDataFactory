				}
			},
			{
				"name": "UPDATE_LATEST_CDC_LSN",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "MERGE_STAGING_TARGET",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_banking_db",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "@concat(\n    'UPDATE ',\n    pipeline().parameters.schema,\n    '.',\n    pipeline().parameters.cdc_table_name,\n    ' SET LastProcessedLSN = CONVERT(BINARY(10), ''',\n    activity('Fetch_Current_CDC_LSN').output.firstRow.MaxLSN,\n    ''', 1)',\n    ' WHERE TableName = ''',\n    pipeline().parameters.table_name,\n    ''''\n)",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00",
					"logSettings": {
						"logDestination": "ActivityOutput"
					}
				}
			},
			{
				"name": "Fetch_Current_CDC_LSN",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT sys.fn_varbintohexstr(sys.fn_cdc_get_max_lsn()) AS MaxLSN;",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference",
						"parameters": {
							"schema": {
								"value": "@pipeline().parameters.schema",
								"type": "Expression"
							},
							"table_name": {
								"value": "@pipeline().parameters.table_name",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Truncate Staging",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_banking_db",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "@concat(\n    'TRUNCATE TABLE ',\n    pipeline().parameters.schema,\n    '.',\n    pipeline().parameters.staging_table\n)",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "MERGE_STAGING_TARGET",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "SQL_SOURCE_STAGING",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_banking_db",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "@concat(\n'DELETE T\nFROM ',\npipeline().parameters.schema,\n'.',\npipeline().parameters.target_table,\n' AS T\nINNER JOIN ',\npipeline().parameters.schema,\n'.',\npipeline().parameters.staging_table,\n' AS S\n    ON T.CustomerID = S.CustomerID\nWHERE S.CDC_Operation = 1;\n\nMERGE ',\npipeline().parameters.schema,\n'.',\npipeline().parameters.target_table,\n' AS T\nUSING (\n    SELECT\n        CustomerID,\n        CustomerName,\n        Region,\n        Email,\n        ModifiedDate\n    FROM ',\npipeline().parameters.schema,\n'.',\npipeline().parameters.staging_table,\n' \n    WHERE CDC_Operation IN (2, 4)\n) AS S\n\nON T.CustomerID = S.CustomerID\n\nWHEN MATCHED THEN\n    UPDATE SET\n        T.CustomerName = S.CustomerName,\n        T.Region = S.Region,\n        T.Email = S.Email,\n        T.ModifiedDate = S.ModifiedDate\n\nWHEN NOT MATCHED BY TARGET THEN\n    INSERT (\n        CustomerID,\n        CustomerName,\n        Region,\n        Email,\n        ModifiedDate\n    )\n    VALUES (\n        S.CustomerID,\n        S.CustomerName,\n        S.Region,\n        S.Email,\n        S.ModifiedDate\n    );'\n)",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
