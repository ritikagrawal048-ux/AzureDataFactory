				"type": "string",
				"defaultValue": "Customers"
			},
			"staging_table": {
				"type": "string",
				"defaultValue": "customers_staging_CDC"
			},
			"target_table": {
				"type": "string",
				"defaultValue": "customers_target_cdc"
			},
			"cdc_table_name": {
				"type": "string",
				"defaultValue": "CDC_Watermark"
			}
		},
