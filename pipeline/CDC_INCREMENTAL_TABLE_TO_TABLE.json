								"type": "Expression"
							},
							"table_name": {
								"value": "@pipeline().parameters.cdc_table_name",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "SQL_SOURCE_STAGING",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Fetch_Last_CDC_LSN",
						"dependencyConditions": [
							"Succeeded"
						]
