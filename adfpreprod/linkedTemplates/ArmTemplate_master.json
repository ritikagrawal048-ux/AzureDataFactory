{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfpreprod"
		},
		"ls_banking_db_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_banking_db'"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://preprodstoragedl.dfs.core.windows.net/"
		},
		"ls_banking_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adfpreprodsqlserver.database.windows.net"
		},
		"ls_banking_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "banking_db"
		},
		"ls_banking_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adf_sql_server"
		},
		"trigger1_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/97d0322e-0bf1-4076-8169-73856ada0cb3/resourceGroups/banking/providers/Microsoft.Storage/storageAccounts/preprodstoragedl"
		},
		"trigger_event_storage_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/97d0322e-0bf1-4076-8169-73856ada0cb3/resourceGroups/banking/providers/Microsoft.Storage/storageAccounts/preprodstoragedl"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfpreprod_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_banking_db_password": {
						"value": "[parameters('ls_banking_db_password')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_banking_db_properties_typeProperties_server": {
						"value": "[parameters('ls_banking_db_properties_typeProperties_server')]"
					},
					"ls_banking_db_properties_typeProperties_database": {
						"value": "[parameters('ls_banking_db_properties_typeProperties_database')]"
					},
					"ls_banking_db_properties_typeProperties_userName": {
						"value": "[parameters('ls_banking_db_properties_typeProperties_userName')]"
					},
					"trigger1_properties_typeProperties_scope": {
						"value": "[parameters('trigger1_properties_typeProperties_scope')]"
					},
					"trigger_event_storage_properties_typeProperties_scope": {
						"value": "[parameters('trigger_event_storage_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}